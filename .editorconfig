root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is tab-indented by gofmt; the width is a display preference only.
[*.go]
indent_style = tab

# Recipe bodies in a justfile are indented; keep them consistent.
[justfile]
indent_style = space
indent_size = 4

# Two trailing spaces are a hard line break in Markdown; do not strip them.
[*.md]
trim_trailing_whitespace = false
